<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>新闻离线档案馆</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #f5f7fa;
            color: #1a1a2e;
            padding: 20px;
        }
        .container { max-width: 1400px; margin: 0 auto; }
        header {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            color: white;
            padding: 40px;
            border-radius: 16px;
            margin-bottom: 30px;
        }
        header h1 { font-size: 2.5rem; margin-bottom: 10px; }
        header .stats {
            display: flex;
            gap: 30px;
            margin-top: 15px;
            font-size: 0.95rem;
            opacity: 0.8;
        }
        .stats span { background: rgba(255,255,255,0.1); padding: 4px 14px; border-radius: 20px; }
        .search-box {
            width: 100%;
            max-width: 400px;
            padding: 12px 20px;
            border: 2px solid #e0e0e0;
            border-radius: 30px;
            font-size: 1rem;
            transition: all 0.3s;
            margin-bottom: 25px;
        }
        .search-box:focus { border-color: #1a1a2e; outline: none; box-shadow: 0 0 0 3px rgba(26,26,46,0.1); }
        .site-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 24px;
        }
        .site-card {
            background: white;
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            transition: transform 0.2s, box-shadow 0.2s;
            border: 1px solid #eee;
        }
        .site-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.1);
        }
        .site-card h2 {
            font-size: 1.2rem;
            margin-bottom: 6px;
            color: #1a1a2e;
        }
        .site-card .domain {
            color: #888;
            font-size: 0.85rem;
            margin-bottom: 12px;
            word-break: break-all;
        }
        .site-card .snapshot-info {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 12px;
            border-top: 1px solid #f0f0f0;
            font-size: 0.9rem;
            color: #666;
        }
        .btn {
            display: inline-block;
            padding: 6px 16px;
            background: #1a1a2e;
            color: white;
            text-decoration: none;
            border-radius: 20px;
            font-size: 0.85rem;
            transition: background 0.2s;
        }
        .btn:hover { background: #2d2d5e; }
        .btn-secondary {
            background: #e8e8e8;
            color: #333;
        }
        .btn-secondary:hover { background: #d0d0d0; }
        .snapshot-list {
            margin-top: 10px;
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
        }
        .snapshot-list.open { max-height: 300px; overflow-y: auto; }
        .snapshot-item {
            display: flex;
            justify-content: space-between;
            padding: 4px 0;
            font-size: 0.8rem;
            color: #666;
            border-bottom: 1px solid #f5f5f5;
        }
        .snapshot-item a { color: #1a1a2e; text-decoration: none; }
        .snapshot-item a:hover { text-decoration: underline; }
        .toggle-btn {
            background: none;
            border: none;
            color: #666;
            cursor: pointer;
            font-size: 0.8rem;
        }
        .toggle-btn:hover { color: #1a1a2e; }
        .footer {
            text-align: center;
            padding: 30px;
            color: #999;
            font-size: 0.85rem;
            margin-top: 30px;
        }
        @media (max-width: 600px) {
            header h1 { font-size: 1.8rem; }
            header .stats { flex-wrap: wrap; gap: 10px; }
            .site-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>📰 新闻离线档案馆</h1>
            <p>自动归档主流英美新闻网站首页，支持离线浏览</p>
            <div class="stats">
                <span>📁 {{ total_sites }} 个网站</span>
                <span>📄 {{ total_snapshots }} 个快照</span>
                <span>🕐 更新于 {{ generated_at }}</span>
            </div>
        </header>

        <input type="text" class="search-box" id="searchInput" placeholder="🔍 搜索网站..." onkeyup="filterSites()">

        <div class="site-grid" id="siteGrid">
            {% for site in archives %}
            <div class="site-card" data-name="{{ site.name }}" data-domain="{{ site.domain }}">
                <h2>{{ site.name }}</h2>
                <div class="domain">{{ site.domain }}</div>
                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    {% if site.latest %}
                    <a href="{{ site.latest.path }}" class="btn" target="_blank">📖 查看最新</a>
                    {% endif %}
                    <button class="btn btn-secondary" onclick="toggleSnapshots(this)">📂 历史 ({{ site.count }})</button>
                    <a href="{{ site.url }}" class="btn btn-secondary" target="_blank">🌐 访问原站</a>
                </div>
                <div class="snapshot-list">
                    {% for snapshot in site.snapshots[:20] %}
                    <div class="snapshot-item">
                        <a href="{{ snapshot.path }}" target="_blank">{{ snapshot.timestamp }}</a>
                        <span>{{ (snapshot.size / 1024)|round(1) }} KB</span>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endfor %}
        </div>

        <div class="footer">
            由 GitHub Actions 自动生成 · 每4小时更新一次
        </div>
    </div>

    <script>
        function toggleSnapshots(btn) {
            const list = btn.closest('.site-card').querySelector('.snapshot-list');
            list.classList.toggle('open');
            btn.textContent = list.classList.contains('open') ? '📂 收起' : `📂 历史 (${list.children.length})`;
        }

        function filterSites() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            document.querySelectorAll('.site-card').forEach(card => {
                const name = card.dataset.name.toLowerCase();
                const domain = card.dataset.domain.toLowerCase();
                card.style.display = (name.includes(query) || domain.includes(query)) ? '' : 'none';
            });
        }
    </script>
</body>
</html>
